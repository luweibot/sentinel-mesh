# =============================================================================
# Sentinel Mesh - example environment configuration (placeholders only)
# =============================================================================
# Copy to .env and adjust. NEVER put private keys, seed phrases or any real
# credentials in this file. Phase 0 performs no live signing and no live
# trading; the platform intentionally has no code path that accepts a private
# key.

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API service ----
API_PORT=3001

# ---- Orchestrator service ----
ORCHESTRATOR_PORT=3002

# CORS allowlist for browser callers (comma-separated origins, "none" to disable).
ALLOWED_ORIGINS=http://localhost:3000

# ---- Web (Next.js) ----
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ---- Infrastructure (optional in development) -------------------------------
# When DATABASE_URL / REDIS_URL are unset, the API starts with in-process
# mock drivers (in-memory event bus, no DB probe). Nothing is persisted.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel_mesh
REDIS_URL=redis://localhost:6379

# ---- Postgres container settings (docker compose only) ----
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel_mesh
POSTGRES_PORT=5432

# ---- Chain adapters ----
# Phase 0 ships deterministic MOCK adapters only. Read-only adapters exist as
# interfaces but are not enabled in this phase.
CHAIN_ADAPTER_MODE=mock
# Reserved for a later phase; leaving these unset is intentional.
# EVM_RPC_URL=
# SOLANA_RPC_URL=

# ---- Guarded-trading guards (phase 0: simulation only) ----
POLICY_MODE=dry-run
EXECUTION_MODE=paper
# Live trading is rejected by config validation; see docs/EXECUTION.md for the go-live checklist.
# EXECUTION_MODE=live   # (rejected)
MOCK_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
# Maximum simulated notional per signal, in USD cents (50000 = $500.00).
POLICY_MAX_NOTIONAL_USD_CENTS=50000
