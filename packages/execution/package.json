{
  "name": "@sentinel-mesh/execution",
  "version": "0.1.0",
  "private": true,
  "description": "Guarded execution pipeline for Sentinel Mesh: short-lived exact-bound authorizations, limit and exposure caps, approval gates, idempotency, simulation, mock signing, kill switches, and reconciliation. Paper trading only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@sentinel-mesh/chain-adapters": "workspace:*",
    "@sentinel-mesh/chain-data": "workspace:*",
    "@sentinel-mesh/config": "workspace:*",
    "@sentinel-mesh/contracts": "workspace:*",
    "@sentinel-mesh/logger": "workspace:*",
    "@sentinel-mesh/policy-engine": "workspace:*",
    "@solana/web3.js": "^1.95.8",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.57.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
