{
  "name": "@sentinel-mesh/payments",
  "version": "0.1.0",
  "private": true,
  "description": "x402 v1 payment guard: requirement verification, replay resistance, settlement evidence, idempotent records, spend caps, recipient allowlists, reconciliation. Paper/mock only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@sentinel-mesh/contracts": "workspace:*",
    "@sentinel-mesh/logger": "workspace:*",
    "viem": "^2.57.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
