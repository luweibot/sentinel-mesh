{
  "name": "@sentinel-mesh/treasury",
  "version": "0.1.0",
  "private": true,
  "description": "Treasury gas top-up: converts received USDC revenue into just enough ETH (Base) and SOL (Solana) gas, with fail-closed minimums and deficit-only conversions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mayanfinance/swap-sdk": "^15.0.0",
    "ethers": "^6.13.4",
    "@sentinel-mesh/chain-adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
