# Sentinel Mesh API service image.
# NOTE: single-stage image chosen deliberately for the phase 0 skeleton
# (see docs/DECISIONS.md). Requires the repository root as build context.
# syntax=docker/dockerfile:1
FROM node:20-alpine
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@sentinel-mesh/api
ENV NODE_ENV=production
ENV API_PORT=3001
EXPOSE 3001
# Apply pending migrations, then start the API server.
CMD ["sh", "-c", "node apps/api/dist/migrate.js && node apps/api/dist/server.js"]
