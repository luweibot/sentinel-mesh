{
  "name": "@sentinel-mesh/orchestrator-service",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel Mesh orchestration service: task issuing, research workflows, traces, budgets, retries, deadlines, and cancellation over the orchestration engine.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "db:migrate": "tsx src/migrate.ts",
    "generate:trace": "tsx scripts/generate-trace.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10",
    "@sentinel-mesh/agents": "workspace:*",
    "@sentinel-mesh/chain-data": "workspace:*",
    "@sentinel-mesh/config": "workspace:*",
    "@sentinel-mesh/contracts": "workspace:*",
    "@sentinel-mesh/database": "workspace:*",
    "@sentinel-mesh/execution": "workspace:*",
    "@sentinel-mesh/logger": "workspace:*",
    "@sentinel-mesh/orchestrator": "workspace:*",
    "@sentinel-mesh/payments": "workspace:*",
    "@sentinel-mesh/policy-engine": "workspace:*",
    "@sentinel-mesh/queue": "workspace:*",
    "@sentinel-mesh/skills": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
