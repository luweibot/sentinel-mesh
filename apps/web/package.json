{
  "name": "@sentinel-mesh/web",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel Mesh web dashboard (Next.js App Router). Read-only overview of the mesh and its guardrails.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app",
    "test": "vitest run",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@sentinel-mesh/contracts": "workspace:*",
    "@vinext/cloudflare": "^1.1.1",
    "next": "^15.5.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.18",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "8.3.0",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
